<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="three_compartments_world">

    <!-- Basic setup -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Function to generate a 2x2m room -->
    <!-- We'll make walls using thin boxes -->

    <!-- Lobby at center (0,0) -->
    <model name="lobby">
      <static>true</static>
      
      <!-- Floor -->
      <link name="floor">
        <collision name="collision">
          <geometry>
            <box>
              <size>2 2 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2 2 0.01</size>
            </box>
          </geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <pose>0 0 0.005 0 0 0</pose>
      </link>
      
      <!-- Walls -->
      <!-- Front -->
      <include>
        <uri>model://grey_wall</uri>
        <pose>0 -1 0.5 0 0 0</pose>
      </include>
      <!-- Back -->
      <include>
        <uri>model://grey_wall</uri>
        <pose>0 1 0.5 0 0 0</pose>
      </include>
      <!-- Left -->
      <include>
        <uri>model://grey_wall</uri>
        <pose>-1 0 0.5 0 0 1.5708</pose>
      </include>
      <!-- Right -->
      <include>
        <uri>model://grey_wall</uri>
        <pose>1 0 0.5 0 0 1.5708</pose>
      </include>
    </model>

    <!-- Compartment A (Top / North) -->
    <model name="compartment_a">
      <static>true</static>
      <include>
        <uri>model://grey_wall</uri>
        <pose>0 3 0.5 0 0 0</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>0 1 0.5 0 0 0</pose> <!-- Bottom shared with lobby -->
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>-1 2 0.5 0 0 1.5708</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>1 2 0.5 0 0 1.5708</pose>
      </include>
    </model>

    <!-- Compartment B (Left / West) -->
    <model name="compartment_b">
      <static>true</static>
      <include>
        <uri>model://grey_wall</uri>
        <pose>-3 0 0.5 0 0 1.5708</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>-1 0 0.5 0 0 1.5708</pose> <!-- Right shared with lobby -->
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>-2 1 0.5 0 0 0</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>-2 -1 0.5 0 0 0</pose>
      </include>
    </model>

    <!-- Compartment C (Right / East) -->
    <model name="compartment_c">
      <static>true</static>
      <include>
        <uri>model://grey_wall</uri>
        <pose>3 0 0.5 0 0 1.5708</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>1 0 0.5 0 0 1.5708</pose> <!-- Left shared with lobby -->
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>2 1 0.5 0 0 0</pose>
      </include>
      <include>
        <uri>model://grey_wall</uri>
        <pose>2 -1 0.5 0 0 0</pose>
      </include>
    </model>

  </world>
</sdf>
