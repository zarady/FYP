<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mahallahroom">
    <gravity>0 0 -9.8</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ==== LOBBY (6x6m) ==== -->
    
    <!-- Moved Back Wall Forward to Fix Gap -->
    <model name="lobby_back_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 2.5</size></box></geometry>
        </visual>
        <pose>0 -0.5 1.25 0 0 0</pose> <!-- Fixed Y position -->
      </link>
    </model>

    <!-- ==== Front Wall (1.3m - 1.5m - 0.4m - 1.5m - 1.3m) ==== -->

    <!-- Left Wall Segment (1.3m) -->
    <model name="lobby_front_left">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 0.1 2.5</size></box></geometry></visual>
        <pose>-2.35 3.05 1.25 0 0 0</pose>
      </link>
    </model>

    <!-- Middle Wall Segment (0.4m) -->
    <model name="lobby_front_middle">
      <static>true</static>
